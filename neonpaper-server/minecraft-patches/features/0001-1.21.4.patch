+    public SnappedChunk snap() {
+        int count = getSectionsCount();
+        SnappedChunk.SnappedSectionData[] data = new SnappedChunk.SnappedSectionData[count];
+        for (int i = 0; i < count; i++) {
+            LevelChunkSection section = getSection(i);
+            data[i] = new SnappedChunk.SnappedSectionData(
+                    section.getNonEmptyBlockCount(),
+                    section.getTickingBlockCount(),
+                    section.getTickingFluidCount(),
+                    section.getSpecialCollidingBlocks(),
+                    section.states
+            );
+        }
+        return new SnappedChunk(data);
+    }
+    // NeonPaper end
