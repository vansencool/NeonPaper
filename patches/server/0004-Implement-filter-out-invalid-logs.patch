diff --git a/src/main/java/net/vansen/neonpaper/config/ConfigVariables.java b/src/main/java/net/vansen/neonpaper/config/ConfigVariables.java
new file mode 100644
index 0000000000000000000000000000000000000000..74038b310241f0c203645d436d83a75b9756eb12
--- /dev/null
+++ b/src/main/java/net/vansen/neonpaper/config/ConfigVariables.java
@@ -0,0 +1,6 @@
+package net.vansen.neonpaper.config;
+
+public class ConfigVariables {
+
+    public static boolean FILTER_OUT_INVALID_LOGS = true;
+}
diff --git a/src/main/java/net/vansen/neonpaper/config/DefaultConfig.java b/src/main/java/net/vansen/neonpaper/config/DefaultConfig.java
index 23b961494be8dfe15d1860e6b42477314589f11b..9637909ca5986953378fccf0a90f8d9b90e3b077 100644
